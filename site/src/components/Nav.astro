---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { t, homePath, type Lang } from '../lib/i18n';
import { DOWNLOAD_URL } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'fr' ? 'en' : 'fr';
---
<header class="nav" data-nav>
  <div class="nav-in">
    <a class="brand" href={homePath(lang)} aria-label="CLEARANCE">
      <Mark size={24} />
      <span>CLEARANCE</span>
    </a>
    <nav class="links" aria-label={d.nav.label}>
      {d.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="right">
      <a class="lang" href={homePath(other)} hreflang={other} lang={other} aria-label={`FR / EN — ${d.nav.switchTo}`}>
        <span class={lang === 'fr' ? 'on' : ''}>FR</span><i aria-hidden="true">/</i><span class={lang === 'en' ? 'on' : ''}>EN</span>
      </a>
      <a class="btn btn-secondary btn-sm cta" href={DOWNLOAD_URL} rel="noopener">
        <Icon name="download" size={16} />{d.nav.cta}
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu" data-burger>
        <span class="sr-only" data-burger-label data-label-open={d.nav.menu} data-label-close={d.nav.close}>{d.nav.menu}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>
</header>
<div class="menu" id="menu" data-menu hidden>
    <nav aria-label={d.nav.label}>
      {d.nav.links.map((l, i) => <a href={l.href} style={`--i:${i}`}><span class="mono">0{i + 1}</span>{l.label}</a>)}
    </nav>
    <div class="menu-foot">
      <a class="btn btn-primary" href={DOWNLOAD_URL} rel="noopener"><Icon name="download" size={18} />{d.hero.ctaPrimary}</a>
      <a class="lang" href={homePath(other)} hreflang={other} lang={other}>{d.nav.switchTo}</a>
    </div>
  </div>


<style>
  .nav{position:fixed;inset:0 0 auto 0;z-index:50;height:var(--nav-h);transition:background var(--dur-base),backdrop-filter var(--dur-base),border-color var(--dur-base);border-bottom:1px solid transparent}
  .nav.menu-open{background:var(--void);border-bottom-color:var(--line)}
  .nav.is-scrolled{background:rgba(7,8,12,.82);-webkit-backdrop-filter:blur(14px) saturate(1.2);backdrop-filter:blur(14px) saturate(1.2);border-bottom-color:var(--line)}
  .nav-in{height:100%;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px;padding-inline:var(--gut);max-width:calc(var(--maxw) + 2*var(--gut));margin-inline:auto}
  .brand{display:inline-flex;align-items:center;gap:12px;font-family:var(--f-display);font-weight:700;font-size:18px;letter-spacing:.1em;justify-self:start;min-height:44px}
  .links{display:flex;gap:clamp(18px,2.4vw,36px)}
  .links a{position:relative;font-family:var(--f-mono);font-size:12px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--tx2);padding:12px 0;transition:color var(--dur-fast)}
  .links a::after{content:"";position:absolute;left:0;right:0;bottom:6px;height:1px;background:var(--cyan);transform:scaleX(0);transform-origin:left;transition:transform var(--dur-base) var(--ease)}
  .links a:hover{color:var(--tx)}
  .links a:hover::after{transform:scaleX(1)}
  .right{display:flex;align-items:center;gap:16px;justify-self:end}
  .lang{display:inline-flex;align-items:center;gap:6px;font-family:var(--f-mono);font-size:12px;letter-spacing:.12em;color:var(--tx2);min-height:44px;padding-inline:4px}
  .lang .on{color:var(--tx)}
  .lang i{font-style:normal;color:var(--tx3)}
  .lang:hover{color:var(--tx)}
  .burger{display:none;width:44px;height:44px;position:relative}
  .burger i{position:absolute;left:11px;right:11px;height:1.5px;background:var(--tx);transition:transform var(--dur-base) var(--ease),top var(--dur-base) var(--ease)}
  .burger i:nth-of-type(1){top:17px}
  .burger i:nth-of-type(2){top:26px}
  .burger[aria-expanded="true"] i:nth-of-type(1){top:21.5px;transform:rotate(45deg)}
  .burger[aria-expanded="true"] i:nth-of-type(2){top:21.5px;transform:rotate(-45deg)}
  .menu{position:fixed;z-index:49;inset:var(--nav-h) 0 0 0;overflow-y:auto;background:var(--void);padding:32px var(--gut) max(32px,env(safe-area-inset-bottom));display:flex;flex-direction:column;justify-content:space-between;border-top:1px solid var(--line)}
  .menu[hidden]{display:none}
  .menu nav{display:grid}
  .menu nav a{display:flex;align-items:baseline;gap:16px;font-family:var(--f-display);font-weight:700;font-size:clamp(34px,10vw,56px);text-transform:uppercase;line-height:1.15;padding:8px 0;border-bottom:1px solid var(--line);animation:in-soft .6s var(--ease) both;animation-delay:calc(60ms * var(--i))}
  .menu nav a .mono{font-size:12px;color:var(--cyan);letter-spacing:.1em}
  .menu-foot{display:flex;flex-direction:column;gap:16px;align-items:flex-start}
  .menu-foot .btn{width:100%}
  @media (max-width:1000px){
    .nav-in{grid-template-columns:1fr auto}
    .links{display:none}
    .burger{display:block}
  }
  @media (max-width:520px){ .right .cta{display:none} .right>.lang{display:none} }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  const label = nav.querySelector<HTMLElement>('[data-burger-label]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const outside = () => [...document.querySelectorAll<HTMLElement>('main, footer, .skip')];
  const focusables = () => [burger, ...menu.querySelectorAll<HTMLElement>('a')];
  const setOpen = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    label.textContent = open ? label.dataset.labelClose! : label.dataset.labelOpen!;
    menu.hidden = !open;
    nav.classList.toggle('menu-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
    outside().forEach((el) => { if (open) el.setAttribute('inert', ''); else el.removeAttribute('inert'); });
    if (open) menu.querySelector<HTMLElement>('a')?.focus();
  };
  burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => {
    if (menu.hidden) return;
    if (e.key === 'Escape') { setOpen(false); burger.focus(); return; }
    if (e.key === 'Tab') {
      const f = focusables(), i = f.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); }
      else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }
    }
  });
  addEventListener('resize', () => { if (innerWidth > 1000 && !menu.hidden) setOpen(false); });
</script>
