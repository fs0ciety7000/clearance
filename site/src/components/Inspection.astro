---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { shot } from '../lib/shots';
import { t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const d = t(Astro.props.lang);
const s = d.inspection;
const f = s.fields;
// Dossier fictif (règles du jeu) : deux discordances — N° ID (carte ≠ permis) et permis expiré.
const card = [
  { k: 'name', v: 'NAVARRE' },
  { k: 'first', v: 'ELIO' },
  { k: 'birth', v: '09.07.2154' },
  { k: 'origin', v: s.values.origin, code: 'TYC' },
  { k: 'id', v: 'HG-4382-T7KM', wide: true },
  { k: 'expiry', v: '02.11.2189' },
];
const permit = [
  { k: 'name', v: 'NAVARRE' },
  { k: 'birth', v: '09.07.2154' },
  { k: 'id', v: 'HG-4382-T7KN', wide: true },
  { k: 'purpose', v: s.values.purpose },
  { k: 'duration', v: s.values.duration },
  { k: 'expiry', v: '12.03.2187' },
];
const label = (k: string) => (f as Record<string, string>)[k] ?? k;
const i18n = JSON.stringify({ results: s.results, reasons: s.reasons, verdicts: s.verdicts, live: s.live, hintIdle: s.hintIdle, hintPicked: s.hintPicked, today: s.today });
---
<section class="section insp" id="inspection" aria-labelledby="insp-title">
  <div class="wrap">
    <header class="section-head head">
      <div>
        <p class="kicker">{s.label}</p>
        <h2 class="h2" id="insp-title" data-reveal>{s.title}</h2>
      </div>
      <p class="lede" data-reveal style="--d:.1s">{s.intro}</p>
    </header>

    <div class="bench gridbg" data-bench data-i18n={i18n}>
      <div class="bench-bar">
        <span class="label"><Icon name="diamond" size={14} /> {s.benchLabel}</span>
        <span class="count label">{s.found} <b class="mono" data-count>0</b><span class="mono"> / 2</span></span>
      </div>

      <div class="docs">
        <article class="doc holo chamfer chamfer-l" aria-label={s.docs.card.type} data-doc="card">
          <header class="doc-h">
            <div><span class="issuer">{s.docs.card.issuer}</span><b>{s.docs.card.type}</b></div>
            <span class="serial mono">{s.docs.card.serial}</span>
          </header>
          <div class="doc-b">
            <figure class="portrait"><Image src={shot('portrait_demo')} alt="" widths={[132, 264]} sizes="132px" loading="lazy" /></figure>
            <div class="fields">
              {card.map((x) => (
                <button type="button" class={x.wide ? 'field wide' : 'field'} data-doc="card" data-k={x.k} data-v={x.v} data-code={x.code} data-label={label(x.k)} aria-pressed="false">
                  <span class="fl">{label(x.k)}</span><span class="fv">{x.v}</span><i class="tag" aria-hidden="true"></i>
                </button>
              ))}
            </div>
          </div>
          <footer class="mrz mono" aria-hidden="true">HG4382T7KM&lt;TYC&lt;NAVARRE&lt;&lt;ELIO&lt;&lt;&lt;&lt;04</footer>
        </article>

        <article class="doc holo chamfer chamfer-l" aria-label={s.docs.permit.type} data-doc="permit">
          <header class="doc-h">
            <div><span class="issuer">{s.docs.permit.issuer}</span><b>{s.docs.permit.type}</b></div>
            <span class="serial mono">{s.docs.permit.serial}</span>
          </header>
          <div class="fields two">
            {permit.map((x) => (
              <button type="button" class={x.wide ? 'field wide' : 'field'} data-doc="permit" data-k={x.k} data-v={x.v} data-label={label(x.k)} aria-pressed="false">
                <span class="fl">{label(x.k)}</span><span class="fv">{x.v}</span><i class="tag" aria-hidden="true"></i>
              </button>
            ))}
          </div>
          <div class="stamp-zone" data-stamp aria-hidden="true"></div>
        </article>

        <aside class="rulebook chamfer" aria-label={s.rulebook}>
          <p class="rb-h">{s.rulebook}</p>
          <button type="button" class="field today" data-doc="rule" data-k="today" data-v={s.todayValue} data-label={s.today} aria-pressed="false">
            <span class="fl">{s.today}</span><span class="fv big">{s.todayValue}</span><i class="tag" aria-hidden="true"></i>
          </button>
          <ol class="rules">
            {s.rules.map((r, i) => <li><span class="mono">0{i + 1}</span>{r}</li>)}
          </ol>
        </aside>

        <svg class="links" data-links aria-hidden="true"></svg>
      </div>

      <div class="console">
        <p class="hint" data-hint>{s.hintIdle}</p>
        <div class="stamps">
          <button type="button" class="stampbtn ok" data-verdict="approve"><Icon name="check" size={26} /><span>{s.stamps.approve}</span></button>
          <button type="button" class="stampbtn no" data-verdict="deny"><Icon name="octagon" size={26} /><span>{s.stamps.deny}</span></button>
        </div>
      </div>
      <div class="verdict" data-verdict-box hidden>
        <div class="v-in">
          <p class="v-title" data-v-title></p>
          <p class="v-text" data-v-text></p>
        </div>
        <button type="button" class="btn btn-secondary btn-sm" data-reset>{s.stamps.reset}</button>
      </div>
      <p class="sr-only" aria-live="assertive" data-live></p>
    </div>
    <p class="keys mono">{s.keys}</p>
  </div>
</section>

<style>
  .insp{border-top:1px solid var(--line)}
  .head{grid-template-columns:1fr minmax(0,30rem);align-items:end}
  .head > div{display:grid;gap:24px}
  .bench{position:relative;background-color:var(--void);border:1px solid var(--line);padding:clamp(16px,2.4vw,32px)}
  .bench-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;gap:16px}
  .bench-bar .label{display:inline-flex;gap:10px;align-items:center;font-size:11px}
  .bench-bar .label:first-child{color:var(--cyan)}
  .count{white-space:nowrap}
  .count b{color:var(--magenta);font-size:14px}
  .docs{position:relative;display:grid;grid-template-columns:1.15fr 1fr .78fr;gap:clamp(20px,3vw,48px);align-items:start}

  .doc{padding:0 0 16px;--c:16px}
  .doc::before{content:"";position:absolute;inset:0;z-index:0;background:repeating-linear-gradient(0deg,#00E5FF0D 0 1px,transparent 1px 3px);pointer-events:none}
  .doc-h,.doc-b,.fields,.mrz{position:relative;z-index:1}
  .doc-h{display:flex;justify-content:space-between;gap:12px;padding:14px 18px 12px 22px;background:var(--cyan-24);border-bottom:1px solid var(--cyan-40)}
  .doc-h div{display:grid;gap:4px}
  .issuer{font-family:var(--f-mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan)}
  .doc-h b{font-family:var(--f-display);font-weight:600;font-size:21px;text-transform:uppercase;letter-spacing:.02em}
  .serial{font-size:11px;color:var(--tx);white-space:nowrap}
  .doc-b{display:grid;grid-template-columns:auto 1fr;gap:16px;padding:16px 16px 0}
  .portrait{width:clamp(84px,8vw,124px);border:1px solid var(--cyan-40);align-self:start;background:var(--elev)}
  .portrait :global(img){width:100%;aspect-ratio:264/318;object-fit:cover}
  .fields{display:grid;grid-template-columns:1fr 1fr;gap:4px}
  .fields.two{padding:16px 16px 0}
  .field{position:relative;display:grid;gap:3px;text-align:left;min-height:52px;padding:8px 26px 8px 12px;border-left:2px solid transparent;transition:background var(--dur-fast),border-color var(--dur-fast);z-index:1}
  .field.wide{grid-column:1/-1}
  .fl{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--tx2)}
  .fv{font-family:var(--f-mono);font-weight:500;font-size:15px;color:var(--tx);font-variant-numeric:tabular-nums;white-space:nowrap}
  .fv.big{font-size:22px}
  .field:hover{background:var(--cyan-08)}
  .field[aria-pressed="true"]{background:var(--cyan-12);border-left-color:var(--cyan)}
  .field.flag{background:var(--magenta-12);box-shadow:inset 0 0 0 1px var(--magenta);border-left-color:var(--magenta)}
  .field.flag .fl::after{content:" — ≠";color:var(--magenta)}
  .field.ok .tag{position:absolute;right:8px;top:10px;width:12px;height:7px;border-left:2px solid var(--green);border-bottom:2px solid var(--green);transform:rotate(-45deg)}
  .field:focus-visible{outline:2px solid var(--cyan);outline-offset:-2px}
  .field:disabled{cursor:default}
  .mrz{margin:12px 16px 0;padding-top:10px;border-top:1px dashed var(--cyan-24);font-size:11.5px;color:var(--tx2);letter-spacing:.04em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

  .rulebook{background:var(--panel);border:1px solid var(--line);padding:18px;--c:10px}
  .rb-h{font-family:var(--f-display);font-weight:700;font-size:18px;text-transform:uppercase;margin-bottom:14px}
  .today{width:100%;background:var(--elev);margin-bottom:16px}
  .rules{display:grid;gap:10px}
  .rules li{display:grid;grid-template-columns:24px 1fr;font-size:13.5px;line-height:1.45;color:var(--tx2)}
  .rules .mono{font-size:11px;color:var(--tx2);padding-top:2px}

  .links{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none;z-index:2}
  .links :global(path){fill:none;stroke-width:2;stroke-linejoin:miter}
  .links :global(.ln-d){stroke:var(--magenta);filter:drop-shadow(0 0 4px var(--magenta-60))}
  .links :global(.ln-c){stroke:var(--tx2);transition:opacity .5s ease 1.2s}
  .links :global(.ln-c.gone){opacity:0}
  .links :global(.ln-i){stroke:var(--amber);stroke-dasharray:6 4;transition:opacity .5s ease 1s}
  .links :global(.ln-i.gone){opacity:0}
  .links :global(rect.an-d){fill:var(--magenta)}
  .links :global(rect.an-c){fill:var(--tx2);transition:opacity .5s ease 1.2s}
  .links :global(rect.an-i){fill:var(--amber);transition:opacity .5s ease 1s}
  .links :global(rect.gone){opacity:0}
  .docs :global(.chip){position:absolute;z-index:3;transform:translate(-50%,-50%);display:grid;place-items:center;width:24px;height:24px;font-family:var(--f-mono);font-size:15px;font-weight:700;line-height:1;pointer-events:none;animation:chip .24s var(--ease) both}
  .docs :global(.chip.d){background:var(--magenta);color:var(--void)}
  .docs :global(.chip.c){background:var(--elev);color:var(--tx);box-shadow:inset 0 0 0 1px var(--tx2);transition:opacity .5s ease 1.2s}
  .docs :global(.chip.i){background:var(--elev);color:var(--amber);box-shadow:inset 0 0 0 1px var(--amber);transition:opacity .5s ease 1s}
  .docs :global(.chip.gone){opacity:0}
  .docs :global(.chip) :global(small){font-weight:500;letter-spacing:.02em;text-transform:none;opacity:.85}
  @keyframes chip{from{opacity:0;transform:translate(-50%,-30%)}}

  .stamp-zone{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;z-index:4}
  .stamp-zone :global(.stamp){display:inline-flex;align-items:center;gap:14px;padding:14px 26px;font-family:var(--f-display);font-weight:700;font-size:clamp(30px,3.4vw,46px);letter-spacing:.06em;text-transform:uppercase;border:3px solid currentColor;outline:1px solid currentColor;outline-offset:4px;background:#07080CCC;transform:rotate(-4deg);animation:impact .4s var(--ease-impact) both}
  .stamp-zone :global(.stamp.ok){color:var(--green);box-shadow:0 0 40px -6px var(--green)}
  .stamp-zone :global(.stamp.no){color:var(--red);box-shadow:0 0 40px -6px var(--red)}
  @keyframes impact{0%{opacity:0;transform:rotate(-4deg) scale(1.6)}40%{opacity:1;transform:rotate(-4deg) scale(.96)}100%{transform:rotate(-4deg) scale(1)}}

  .console{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:28px;padding-top:20px;border-top:1px solid var(--line);flex-wrap:wrap}
  .hint{font-size:15px;color:var(--tx2);min-height:1.6em}
  .hint :global(b){color:var(--cyan);font-weight:600}
  .stamps{display:flex;gap:12px}
  .stampbtn{--c:8px;display:inline-flex;align-items:center;gap:12px;min-height:56px;padding:0 22px;font-family:var(--f-display);font-weight:700;font-size:19px;letter-spacing:.06em;text-transform:uppercase;background:var(--panel);clip-path:polygon(var(--c) 0,100% 0,100% calc(100% - var(--c)),calc(100% - var(--c)) 100%,0 100%,0 var(--c));transition:background var(--dur-fast),box-shadow var(--dur-fast)}
  .stampbtn.ok{color:var(--green);box-shadow:inset 0 0 0 1px #2EFF9A80}
  .stampbtn.no{color:var(--red);box-shadow:inset 0 0 0 1px #FF3B3B80}
  .stampbtn.ok:hover{background:var(--green-12);box-shadow:inset 0 0 0 1px var(--green)}
  .stampbtn.no:hover{background:var(--red-12);box-shadow:inset 0 0 0 1px var(--red)}
  .stampbtn :global(svg){flex:none}
  .stampbtn:disabled{opacity:.35;cursor:not-allowed}
  .stampbtn:focus-visible{outline:none;box-shadow:inset 0 0 0 2px var(--cyan),inset 0 0 0 4px var(--void)}
  .verdict{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:20px;padding:18px 20px;background:var(--elev);border-left:3px solid var(--green);flex-wrap:wrap;animation:in-soft .5s var(--ease) both}
  .verdict[hidden]{display:none}
  .verdict.bad{border-left-color:var(--amber)}
  .v-title{font-family:var(--f-display);font-weight:700;font-size:20px;text-transform:uppercase;margin-bottom:4px}
  .verdict.bad .v-title{color:var(--amber)}
  .verdict:not(.bad) .v-title{color:var(--green)}
  .v-text{color:var(--tx2);max-width:60ch;font-size:15px}
  @media (hover:none){.keys{display:none}}
  .keys{margin-top:16px;font-size:11.5px;color:var(--tx2);letter-spacing:.04em}

  @media (max-width:1100px){.docs{grid-template-columns:1fr 1fr}.rulebook{grid-column:1/-1;display:grid;grid-template-columns:auto 1fr;gap:8px 24px;align-items:start}.rb-h{grid-column:1/-1;margin:0}.today{margin:0;min-width:220px}}
  @media (max-width:860px){.head{grid-template-columns:1fr}}
  @media (max-width:700px){
    .docs{grid-template-columns:1fr;padding-left:14px}
    .rulebook{display:block}.today{margin-bottom:16px}
    .doc-b{grid-template-columns:1fr}.portrait{width:96px}
    .console{flex-direction:column;align-items:stretch}.stamps .stampbtn{flex:1;justify-content:center}
  }
  @media (max-width:420px){.fields{grid-template-columns:1fr}}
</style>

<script>
  type Res = 'd' | 'c' | 'i';
  const bench = document.querySelector<HTMLElement>('[data-bench]');
  if (bench) {
    const L = JSON.parse(bench.dataset.i18n!);
    const docsEl = bench.querySelector<HTMLElement>('.docs')!;
    const svg = bench.querySelector<SVGSVGElement>('[data-links]')!;
    const hint = bench.querySelector<HTMLElement>('[data-hint]')!;
    const live = bench.querySelector<HTMLElement>('[data-live]')!;
    const countEl = bench.querySelector<HTMLElement>('[data-count]')!;
    const fields = [...bench.querySelectorAll<HTMLButtonElement>('.field')];
    const stampZone = bench.querySelector<HTMLElement>('[data-stamp]')!;
    const vBox = bench.querySelector<HTMLElement>('[data-verdict-box]')!;
    const stampBtns = [...bench.querySelectorAll<HTMLButtonElement>('[data-verdict]')];
    const NS = 'http://www.w3.org/2000/svg';
    const fill = (str: string, o: Record<string, string>) => str.replace(/\{(\w)\}/g, (_, k) => o[k] ?? '');
    const parse = (v: string) => { const [d, m, y] = v.split('.').map(Number); return new Date(y, m - 1, d).getTime(); };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let picked: HTMLButtonElement | null = null;
    let links: { a: HTMLButtonElement; b: HTMLButtonElement; r: Res; text: string; path?: SVGPathElement; chip?: HTMLElement; anchors?: SVGRectElement[] }[] = [];
    const pairKey = (a: HTMLElement, b: HTMLElement) => [`${a.dataset.doc}.${a.dataset.k}`, `${b.dataset.doc}.${b.dataset.k}`].sort().join('|');
    const found = new Set<string>();
    let done = false;

    const compare = (a: HTMLButtonElement, b: HTMLButtonElement): { r: Res; text: string; key?: string } => {
      const A = a.dataset, B = b.dataset;
      const ks = [A.k, B.k].sort().join('|');
      if (ks === 'expiry|today') {
        const exp = A.k === 'expiry' ? a : b;
        const today = A.k === 'today' ? a : b;
        if (parse(exp.dataset.v!) < parse(today.dataset.v!)) return { r: 'd', text: fill(L.reasons.expired, { a: exp.dataset.v! }), key: `${exp.dataset.doc}.expiry` };
        return { r: 'c', text: L.reasons.valid };
      }
      if (A.k === B.k && A.doc !== B.doc && ['name', 'first', 'birth', 'id'].includes(A.k!)) {
        if (A.v === B.v) return { r: 'c', text: fill(L.reasons.match, { f: A.label!, a: A.v!, b: B.v! }) };
        return { r: 'd', text: fill(L.reasons.mismatch, { f: A.label!, a: A.v!, b: B.v! }), key: `${A.k}` };
      }
      if (ks === 'id|origin') {
        const o = A.k === 'origin' ? a : b, id = A.k === 'id' ? a : b;
        const ok = o.dataset.code === 'TYC' && id.dataset.v!.startsWith('HG-4');
        return ok ? { r: 'c', text: L.reasons.originOk } : { r: 'd', text: L.reasons.originOk, key: 'origin' };
      }
      return { r: 'i', text: L.reasons.none };
    };

    const center = (el: Element) => {
      const r = el.getBoundingClientRect(), o = docsEl.getBoundingClientRect();
      return { l: r.left - o.left, r: r.right - o.left, t: r.top - o.top, cy: r.top - o.top + r.height / 2, cx: r.left - o.left + r.width / 2 };
    };
    const route = (a: Element, b: Element) => {
      let A = center(a), B = center(b);
      if (A.cx > B.cx) [A, B] = [B, A];
      if (B.l > A.r + 8) {
        const x1 = A.r, x2 = B.l, mx = Math.round((x1 + x2) / 2);
        return { d: `M${x1} ${A.cy} H${mx} V${B.cy} H${x2}`, mx, my: (A.cy + B.cy) / 2, x1, y1: A.cy, x2, y2: B.cy };
      }
      const gx = Math.min(A.l, B.l) - 10;
      return { d: `M${A.l} ${A.cy} H${gx} V${B.cy} H${B.l}`, mx: gx, my: (A.cy + B.cy) / 2, x1: A.l, y1: A.cy, x2: B.l, y2: B.cy, side: true };
    };
    const place = (lk: (typeof links)[number]) => {
      const p = route(lk.a, lk.b);
      lk.path!.setAttribute('d', p.d);
      lk.chip!.style.left = `${p.mx}px`;
      lk.chip!.style.top = `${p.my}px`;
      lk.anchors?.forEach((r, i) => { r.setAttribute('x', String((i ? p.x2 : p.x1) - 3)); r.setAttribute('y', String((i ? p.y2 : p.y1) - 3)); });
    };
    const draw = (lk: (typeof links)[number]) => {
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('class', `ln-${lk.r}`);
      svg.appendChild(path);
      const chip = document.createElement('span');
      chip.className = `chip ${lk.r}`;
      const lbl = lk.r === 'd' ? L.results.discord : lk.r === 'c' ? L.results.concord : L.results.incomparable;
      const glyph = lk.r === 'd' ? '≠' : lk.r === 'c' ? '=' : '?';
      chip.textContent = glyph;
      chip.title = lbl;
      docsEl.appendChild(chip);
      const anchors = [0, 1].map(() => { const r = document.createElementNS(NS, 'rect'); r.setAttribute('width', '6'); r.setAttribute('height', '6'); r.setAttribute('class', `anchor an-${lk.r}`); svg.appendChild(r); return r; });
      lk.path = path; lk.chip = chip; lk.anchors = anchors;
      place(lk);
      if (!reduce) {
        const len = path.getTotalLength();
        path.style.strokeDasharray = lk.r === 'i' ? '6 4' : `${len}`;
        if (lk.r !== 'i') {
          path.style.strokeDashoffset = `${len}`;
          path.getBoundingClientRect();
          path.style.transition = 'stroke-dashoffset 240ms cubic-bezier(.19,1,.22,1)';
          path.style.strokeDashoffset = '0';
          path.addEventListener('transitionend', () => { path.style.strokeDasharray = ''; path.style.strokeDashoffset = ''; path.style.transition = ''; }, { once: true });
        } else path.style.strokeDasharray = '';
      }
      if (lk.r !== 'd') {
        requestAnimationFrame(() => { path.classList.add('gone'); chip.classList.add('gone'); anchors.forEach((r) => r.classList.add('gone')); });
        setTimeout(() => { path.remove(); chip.remove(); anchors.forEach((r) => r.remove()); links = links.filter((x) => x !== lk); }, 2000);
      }
    };

    const select = (el: HTMLButtonElement) => {
      if (done) return;
      if (!picked) {
        picked = el; el.setAttribute('aria-pressed', 'true');
        hint.innerHTML = fill(L.hintPicked, { a: `<b>${el.dataset.label}</b>` });
        return;
      }
      if (picked === el) { reset(); return; }
      const a = picked, b = el;
      a.setAttribute('aria-pressed', 'false');
      picked = null;
      const res = compare(a, b);
      const dup = links.find((x) => pairKey(x.a, x.b) === pairKey(a, b));
      if (dup) {
        dup.chip?.animate([{ transform: 'translate(-50%,-50%) scale(1.5)' }, { transform: 'translate(-50%,-50%) scale(1)' }], { duration: 400, easing: 'cubic-bezier(.34,1.56,.64,1)' });
        const dl = res.r === 'd' ? L.results.discord : res.r === 'c' ? L.results.concord : L.results.incomparable;
        hint.innerHTML = `<b style="color:${res.r === 'd' ? 'var(--magenta)' : res.r === 'c' ? 'var(--tx)' : 'var(--amber)'}">${dl}</b> — ${res.text}`;
        return;
      }
      const lk = { a, b, r: res.r, text: res.text };
      links.push(lk);
      draw(lk);
      const names = { a: a.dataset.label!, b: b.dataset.label! };
      const col = res.r === 'd' ? 'var(--magenta)' : res.r === 'c' ? 'var(--tx)' : 'var(--amber)';
      const lbl = res.r === 'd' ? L.results.discord : res.r === 'c' ? L.results.concord : L.results.incomparable;
      hint.innerHTML = `<b style="color:${col}">${lbl}</b> — ${res.text}`;
      if (res.r === 'd') {
        [a, b].forEach((f) => { f.classList.remove('ok'); f.classList.add('flag'); });
        if (res.key) found.add(res.key);
        countEl.textContent = String(found.size);
        live.textContent = fill(L.live.discord, names) + ' ' + res.text;
      } else if (res.r === 'c') {
        [a, b].forEach((f) => { if (!f.classList.contains('flag')) f.classList.add('ok'); });
        live.textContent = fill(L.live.concord, names);
      } else {
        live.textContent = fill(L.live.incomparable, names);
      }
    };
    const reset = () => { if (picked) picked.setAttribute('aria-pressed', 'false'); picked = null; hint.textContent = L.hintIdle; };

    fields.forEach((el) => el.addEventListener('click', () => select(el)));
    bench.addEventListener('keydown', (e) => { if (e.key === 'Escape') reset(); });
    new ResizeObserver(() => links.forEach(place)).observe(docsEl);

    stampBtns.forEach((btn) => btn.addEventListener('click', () => {
      if (done) return;
      done = true;
      reset();
      const kind = btn.dataset.verdict as 'approve' | 'deny';
      const v = kind === 'approve' ? L.verdicts.approve : found.size >= 2 ? L.verdicts.denyOk : found.size === 1 ? L.verdicts.denyPartial : L.verdicts.denyNone;
      const good = kind === 'deny' && found.size > 0;
      stampZone.innerHTML = `<span class="stamp ${kind === 'approve' ? 'ok' : 'no'}">${btn.querySelector('span')!.textContent}</span>`;
      fields.forEach((f) => (f.disabled = true));
      stampBtns.forEach((b) => (b.disabled = true));
      vBox.hidden = false;
      vBox.classList.toggle('bad', !good);
      vBox.querySelector('[data-v-title]')!.textContent = v.title;
      vBox.querySelector('[data-v-text]')!.textContent = v.text;
      live.textContent = `${v.title}. ${v.text}`;
      hint.textContent = '';
      vBox.querySelector<HTMLElement>('[data-reset]')!.focus();
    }));

    bench.querySelector('[data-reset]')!.addEventListener('click', () => {
      done = false; found.clear(); countEl.textContent = '0';
      svg.innerHTML = ''; docsEl.querySelectorAll('.chip').forEach((c) => c.remove()); links = [];
      fields.forEach((f) => { f.disabled = false; f.classList.remove('flag', 'ok'); f.setAttribute('aria-pressed', 'false'); });
      stampBtns.forEach((b) => (b.disabled = false));
      stampZone.innerHTML = ''; vBox.hidden = true; reset();
      fields[0].focus();
    });
  }
</script>
