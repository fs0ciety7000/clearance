---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { shot } from '../lib/shots';
import { t, type Lang } from '../lib/i18n';
import { DOWNLOAD_URL } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<section class="hero" aria-labelledby="hero-title">
  <div class="media" aria-hidden="true">
    <Picture
      fallbackFormat="webp"
      src={shot('hero_band')}
      formats={['avif', 'webp']}
      widths={[480, 960]}
      sizes="50vw"
      alt=""
      loading="eager"
      fetchpriority="low"
      decoding="async"
      class="media-img"
    />
    <div class="scrim"></div>
    <canvas class="rain" data-rain></canvas>
    <div class="scan"></div>
  </div>

  <figure class="screen">
    <div class="screen-in">
      <Picture
        fallbackFormat="webp"
        src={shot('m9_booth_j1')}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 760px) 92vw, 62vw"
        alt={d.hero.imgAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="screen-img"
      />
      <span class="glare" aria-hidden="true"></span>
    </div>
    <figcaption class="screen-cap mono" aria-hidden="true"><span>REC</span> {d.hero.rec}</figcaption>
  </figure>

  <div class="hud wrap" aria-hidden="true">
    <span class="hud-tl label appear appear--fade" style="--d:.2s"><i class="dot"></i>{d.hero.corner}</span>
    <span class="hud-tr label appear appear--fade" style="--d:.3s">
      <span>{d.hero.shift}</span>
      <b class="clock mono" data-clock>10:00</b>
      <span class="bar" data-bar>{Array.from({ length: 16 }).map(() => <i></i>)}</span>
      <span class="end">{d.hero.end}</span>
    </span>
  </div>

  <div class="content wrap">
    <p class="eyebrow kicker consortium appear appear--soft" style="--d:.15s">{d.hero.eyebrow}</p>
    <h1 id="hero-title" class="title" data-scanline>
      <span class="title-in">{d.hero.title}</span>
    </h1>
    <div class="row">
      <p class="tagline appear appear--soft" style="--d:.95s">{d.hero.tagline}</p>
      <div class="ctas">
        <a class="btn btn-primary appear appear--btn" style="--d:1.1s" href={DOWNLOAD_URL} rel="noopener">
          <Icon name="download" size={18} />{d.hero.ctaPrimary}
        </a>
        <a class="btn btn-secondary appear appear--btn" style="--d:1.22s" href="#inspection">
          {d.hero.ctaSecondary}<Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
    <ul class="strip appear appear--fade" style="--d:1.4s" aria-label={d.hero.stripLabel}>
      {d.hero.strip.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<style>
  .hero{position:relative;min-height:680px;height:100vh;height:100svh;max-height:1200px;display:flex;flex-direction:column;justify-content:flex-end;isolation:isolate;overflow:hidden;background:var(--void)}
  .media{position:absolute;inset:0;z-index:-2}
  .media :global(.media-img){position:absolute;inset:-4%;width:108%;height:108%;object-fit:cover;object-position:50% 40%;filter:blur(16px) brightness(.5) saturate(1.25)}
  .scrim{position:absolute;inset:0;background:
    linear-gradient(to top,#07080C 0%,#07080CF0 26%,#07080C99 52%,#07080C59 78%,#07080CB3 100%),
    linear-gradient(90deg,#07080CCC 0%,#07080C66 40%,#07080C00 70%)}
  .rain{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
  .scan{position:absolute;inset:0;background:repeating-linear-gradient(0deg,#00E5FF08 0 1px,transparent 1px 3px);pointer-events:none}

  .screen{position:absolute;z-index:-1;top:calc(var(--nav-h) + 64px);right:var(--gut);width:min(60vw,1040px);perspective:1800px;margin:0}
  .screen-in{position:relative;aspect-ratio:16/9;transform-origin:100% 50%;transform:rotateY(-17deg) rotateX(3deg);border:1px solid var(--cyan-40);background:var(--panel);box-shadow:0 0 0 1px #07080C,0 50px 140px -30px #00E5FF40,-40px 40px 100px -20px #000;animation:tilt 1.8s var(--ease) .1s both}
  @keyframes tilt{from{transform:rotateY(-28deg) rotateX(6deg) translateX(60px)}}
  .screen :global(.screen-img){width:100%;height:100%;object-fit:cover}
  .glare{position:absolute;inset:0;background:linear-gradient(115deg,#FFFFFF14 0%,#FFFFFF00 38%),repeating-linear-gradient(0deg,#00E5FF0D 0 1px,transparent 1px 3px);pointer-events:none}
  .screen-in::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,#07080CE6 0%,#07080C00 45%);pointer-events:none}
  .screen-cap{position:absolute;right:0;top:calc(100% + 14px);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--tx2)}
  .screen-cap span{color:var(--red);margin-right:8px}
  .screen-cap span::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);margin-right:6px;vertical-align:1px;animation:blink 2s steps(2) infinite}
  @keyframes blink{50%{opacity:.2}}

  .hud{position:absolute;top:calc(var(--nav-h) + 20px);left:0;right:0;display:flex;justify-content:space-between;gap:24px}
  .hud .label{font-size:11px;color:#C9D3DD;display:inline-flex;align-items:center;gap:10px}
  .dot{width:6px;height:6px;background:var(--green);display:inline-block;box-shadow:0 0 10px var(--green)}
  .hud-tr{gap:14px!important}
  .clock{font-size:20px;font-weight:700;letter-spacing:-.02em;color:var(--tx);font-variant-numeric:tabular-nums}
  .bar{display:inline-flex;gap:2px}
  .bar i{width:6px;height:8px;background:var(--line)}
  .bar i.on{background:var(--cyan)}
  .end{color:var(--tx2)}

  .content{position:relative;padding-bottom:clamp(28px,4vw,48px)}
  .eyebrow{margin-bottom:clamp(8px,1.4vw,18px)}
  /* seul usage « marque » du jaune dans le hero : l'en-tête du Consortium */
  .eyebrow.consortium{color:var(--yellow)}
  .eyebrow.consortium::before{background:var(--yellow)}
  .title{font-family:var(--f-display);font-weight:700;font-size:clamp(64px,15.6vw,236px);line-height:.8;letter-spacing:-.02em;margin-left:-.04em;color:var(--tx);position:relative;width:max-content;max-width:100%;text-shadow:0 18px 60px #07080C}
  .title-in{display:block;padding-bottom:.06em}
  .js .title .title-in{clip-path:inset(0 0 100% 0);animation:reveal 1.1s var(--ease) .35s forwards}
  .js .title::after{content:"";position:absolute;left:-2%;right:-2%;top:0;height:1px;background:var(--cyan);box-shadow:0 0 18px 2px var(--cyan-60);opacity:0;animation:scanline 1.1s var(--ease) .35s forwards}
  @keyframes reveal{to{clip-path:inset(0 0 0 0)}}
  @keyframes scanline{0%{top:0;opacity:1}85%{opacity:1}100%{top:100%;opacity:0}}

  .row{display:flex;align-items:flex-end;justify-content:space-between;gap:32px 48px;margin-top:clamp(20px,2.4vw,36px);flex-wrap:wrap}
  .tagline{max-width:34rem;font-size:clamp(16px,1.35vw,20px);line-height:1.55;color:#C5CFD9;text-wrap:pretty}
  .ctas{display:flex;gap:12px;flex-wrap:wrap}
  .strip{display:flex;flex-wrap:wrap;gap:6px 0;margin-top:clamp(28px,3.4vw,48px);padding-top:16px;border-top:1px solid #232A38B3}
  .strip li{font-family:var(--f-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--tx2)}
  .strip li+li::before{content:"·";margin:0 12px;color:var(--tx3)}
  .strip li:first-child{color:var(--tx)}

  @media (max-width:760px){
    .hero{height:auto;min-height:100svh;padding-top:calc(var(--nav-h) + 56px)}
    .screen{position:relative;top:auto;right:auto;width:auto;margin:0 var(--gut) 28px;perspective:none}
    .screen-in{transform:none;animation:none}
    .screen-cap{top:auto;bottom:-24px;right:auto;left:0}
    .scrim{background:linear-gradient(to top,#07080C 0%,#07080CE6 50%,#07080C80 100%)}
    .hud-tr .bar,.hud-tr .end,.hud-tr>span:first-child{display:none}
    .ctas{width:100%}
    .ctas .btn{flex:1 1 100%}
  }
  @media (max-height:720px) and (min-width:761px){ .title{font-size:clamp(64px,12vw,170px)} }
  @media (prefers-reduced-motion:reduce){
    .js .title .title-in{clip-path:none;animation:none}
    .js .title::after{display:none}
    .screen-in{animation:none}
    .screen-cap span::before{animation:none}
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Horloge du shift : 10:00 → 18:00, une minute de jeu toutes les 1,125 s (8 h ≈ 9 min réelles, GDD §3.2).
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const bars = document.querySelectorAll<HTMLElement>('[data-bar] i');
  const t0 = performance.now();
  const paint = () => {
    const m = Math.min(480, Math.floor((performance.now() - t0) / 1125));
    const h = 10 + Math.floor(m / 60), mm = m % 60;
    if (clock) clock.textContent = `${String(h).padStart(2, '0')}:${String(mm).padStart(2, '0')}`;
    const on = Math.max(1, Math.ceil((m / 480) * bars.length));
    bars.forEach((b, i) => b.classList.toggle('on', i < on));
  };
  paint();
  setInterval(paint, 1125);

  // Pluie de condensation (canvas 2D léger), en pause hors écran, absente en mouvement réduit.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-rain]');
  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, raf = 0, visible = true;
    type Drop = { x: number; y: number; l: number; v: number; a: number };
    let drops: Drop[] = [];
    const resize = () => {
      const dpr = Math.min(1.5, devicePixelRatio || 1);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(140, (w * h) / 9000));
      drops = Array.from({ length: n }, () => ({ x: Math.random() * w, y: Math.random() * h, l: 10 + Math.random() * 26, v: 5 + Math.random() * 9, a: 0.08 + Math.random() * 0.2 }));
    };
    const slant = 0.14;
    const frame = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.lineWidth = 1;
      for (const d of drops) {
        d.y += d.v; d.x += d.v * slant;
        if (d.y > h) { d.y = -d.l; d.x = Math.random() * w - 40; }
        ctx.strokeStyle = `rgba(190,225,240,${d.a})`;
        ctx.beginPath(); ctx.moveTo(d.x, d.y); ctx.lineTo(d.x - d.l * slant, d.y - d.l); ctx.stroke();
      }
      if (visible) raf = requestAnimationFrame(frame);
    };
    const start = () => { resize(); cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) { cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); } }).observe(canvas);
    addEventListener('resize', resize);
    const idle = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 300));
    idle(start);
  }
</script>
