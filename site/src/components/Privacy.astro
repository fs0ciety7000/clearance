---
// Page « Compte et confidentialité » (M16, lot W). Fidèle à docs/ONLINE.md §9 et server/README.md §7.
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import { t, homePath, privacyPath, type Lang } from '../lib/i18n';
import { REPO_URL } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const all = t(lang);
const p = all.privacy;
const other: Lang = lang === 'fr' ? 'en' : 'fr';
type Section = { id: string; title: string; body?: string[]; list?: string[]; after?: string };
const sections = p.sections as Section[];
---
<Base lang={lang} title={p.meta.title} description={p.meta.description} path={privacyPath(lang)} alternates={{ fr: privacyPath('fr'), en: privacyPath('en') }}>
  <Nav lang={lang} home={false} alt={privacyPath(other)} />
  <main id="main" tabindex="-1" class="priv gridbg">
    <div class="wrap">
      <header class="head">
        <p class="kicker">{p.kicker}</p>
        <h1 class="h2">{p.title}</h1>
        <p class="lede">{p.intro}</p>
        <p class="label upd">{p.updated}</p>
      </header>

      <section class="summary" aria-labelledby="sum-title">
        <h2 class="sr-only" id="sum-title">{p.summaryLabel}</h2>
        <ul>
          {p.summary.map((s, i) => (
            <li class="chamfer"><span class="n mono">0{i + 1}</span><strong>{s.t}</strong><span>{s.x}</span></li>
          ))}
        </ul>
      </section>

      <div class="layout">
        <nav class="toc" aria-labelledby="toc-title">
          <p class="label" id="toc-title">{p.tocLabel}</p>
          <ol>
            {sections.map((s, i) => <li><a href={`#${s.id}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s.title}</a></li>)}
          </ol>
        </nav>
        <div class="body">
          {sections.map((s, i) => (
            <section id={s.id} aria-labelledby={`${s.id}-h`}>
              <h2 id={`${s.id}-h`}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{s.title}</h2>
              {s.body?.map((x) => <p>{x}</p>)}
              {s.list && <ul class="ticks">{s.list.map((x) => <li>{x}</li>)}</ul>}
              {s.after && <p class="after">{s.after}</p>}
              {s.id === 'contact' && (
                <a class="btn btn-secondary" href={`${REPO_URL}/issues`} rel="noopener"><Icon name="ext" size={18} />{p.contactCta}</a>
              )}
            </section>
          ))}
          <p class="site">{p.site}</p>
          <a class="back mono" href={homePath(lang)}><Icon name="chev-l" size={16} />{p.back}</a>
        </div>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Base>
<style>
  .priv{padding:calc(var(--nav-h) + clamp(48px,7vw,96px)) 0 clamp(72px,9vw,128px)}
  .head{display:grid;gap:20px;max-width:52rem}
  .head .h2{font-size:clamp(34px,5vw,64px)}
  .upd{font-size:11px;color:var(--tx3)}
  .summary ul{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:clamp(40px,5vw,64px)}
  .summary li{--c:12px;display:grid;gap:6px;align-content:start;padding:20px 20px 22px;background:linear-gradient(var(--cyan-08),var(--cyan-08)),var(--panel);border-top:2px solid var(--cyan)}
  .summary .n{font-size:11px;color:var(--cyan);letter-spacing:.12em}
  .summary strong{font-family:var(--f-display);font-weight:700;font-size:22px;text-transform:uppercase;line-height:1.05}
  .summary li>span:last-child{color:var(--tx2);font-size:14.5px;line-height:1.5}
  .layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:clamp(32px,6vw,96px);margin-top:clamp(56px,7vw,96px);align-items:start}
  .toc{position:sticky;top:calc(var(--nav-h) + 24px)}
  .toc ol{margin-top:14px;border-top:1px solid var(--line)}
  .toc a{display:flex;gap:12px;align-items:baseline;padding:10px 0;min-height:44px;border-bottom:1px solid var(--line);font-size:14.5px;color:var(--tx2);transition:color var(--dur-fast)}
  .toc a .mono{font-size:11px;color:var(--tx3)}
  .toc a:hover{color:var(--tx)}
  .toc a:hover .mono{color:var(--cyan)}
  .body{display:grid;gap:clamp(40px,4.5vw,56px);max-width:46rem}
  .body section{display:grid;gap:14px;scroll-margin-top:calc(var(--nav-h) + 24px)}
  .body h2{display:flex;gap:16px;align-items:baseline;font-family:var(--f-display);font-weight:700;font-size:clamp(24px,2.4vw,32px);text-transform:uppercase;line-height:1.05;padding-top:18px;border-top:1px solid var(--line)}
  .body h2 .mono{font-size:12px;font-weight:500;color:var(--cyan);letter-spacing:.1em}
  .body p,.body li{color:var(--tx2);font-size:16.5px;line-height:1.65;text-wrap:pretty}
  .ticks{display:grid;gap:10px}
  .ticks li{position:relative;padding-left:24px}
  .ticks li::before{content:"";position:absolute;left:2px;top:.62em;width:7px;height:7px;background:var(--cyan);transform:rotate(45deg)}
  .after{color:var(--tx)!important}
  .body .btn{justify-self:start;margin-top:6px}
  .site{padding:18px 20px;border:1px dashed var(--line);font-size:14.5px!important}
  .back{display:inline-flex;gap:8px;align-items:center;justify-self:start;min-height:44px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--tx2)}
  .back:hover{color:var(--cyan)}
  @media (max-width:1000px){
    .summary ul{grid-template-columns:1fr 1fr}
    .layout{grid-template-columns:1fr}
    .toc{position:static}
  }
  @media (max-width:520px){ .summary ul{grid-template-columns:1fr} .body .btn{white-space:normal;width:100%} }
</style>
