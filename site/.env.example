# URL publique du site (canonical, sitemap, Open Graph)
SITE_URL=https://clearance.cardormedia.com
# Cible des boutons « Télécharger » (page Releases ; ou itch.io / Steam)
PUBLIC_DOWNLOAD_URL=https://github.com/fs0ciety7000/clearance/releases/latest
# Version annoncée, et 1 quand elle est réellement publiée (sinon badge « À venir »)
PUBLIC_VERSION=0.15.0
PUBLIC_RELEASED=0
# 1 pour afficher « Jouer dans le navigateur » (export Web validé, servi sous /play/)
PUBLIC_WEB_DEMO=0
PUBLIC_WEB_DEMO_URL=/play/
